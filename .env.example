# Copy this file to .env and fill in your values.

# ── OPTION 1: Portkey (recommended) ──────────────────────────────────────────
# Sign in at app.portkey.ai
# 1. Copy your Portkey API key from Settings → API Keys
# 2. Add Anthropic as a provider under Virtual Keys → Create Virtual Key
#    (store your Anthropic key there — Portkey keeps it; you never expose it here)
# 3. Copy the generated Virtual Key slug below

PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_VIRTUAL_KEY=your_anthropic_virtual_key_slug_here

# ── OPTION 2: Direct Anthropic (fallback) ────────────────────────────────────
# Used only if PORTKEY_API_KEY is NOT set.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Model ─────────────────────────────────────────────────────────────────────
# Haiku = fast + cheap (good for 54-ticket queue + eval runs)
# Swap to claude-sonnet-4-5 or claude-opus-5 for higher reply quality
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── LangSmith (optional — Portkey already covers observability) ───────────────
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=order-triage-agent
